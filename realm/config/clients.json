{
  "$comment": "Platform OIDC clients. Every product: authorization code + PKCE (S256), direct access grants off, exact redirect URIs, back-channel logout. Secrets are never stored here; apply.mjs prints or writes them.",
  "products": [
    {
      "clientId": "civicos-portal",
      "name": "CivicOS Portal",
      "url": "{{portalUrl}}",
      "backchannelUrl": "{{portalBackchannelUrl}}",
      "erasure": false,
      "$extraRedirectUris": "OCN Docs in DOCS_ADMIN_MODE=legacy signs its admin in through civicos-portal (civicos-docs render.yaml). Keep this until Docs runs DOCS_ADMIN_MODE=civicos on client ocn-docs, then remove it.",
      "extraRedirectUris": [
        "{{docsUrl}}/api/auth/callback/keycloak"
      ]
    },
    {
      "clientId": "ocn-docs",
      "name": "CivicOS Docs",
      "url": "{{docsUrl}}",
      "backchannelUrl": "{{docsBackchannelUrl}}"
    },
    {
      "clientId": "civicos-groups",
      "name": "CivicOS Groups",
      "url": "{{groupsUrl}}",
      "backchannelUrl": "{{groupsBackchannelUrl}}"
    },
    {
      "clientId": "civicos-discuss",
      "name": "CivicOS Discuss",
      "url": "{{discussUrl}}",
      "backchannelUrl": "{{discussBackchannelUrl}}"
    },
    {
      "clientId": "civicos-committee",
      "name": "CivicOS Committees",
      "url": "{{committeeUrl}}",
      "backchannelUrl": "{{committeeBackchannelUrl}}",
      "erasure": false
    }
  ],
  "productTemplate": {
    "protocol": "openid-connect",
    "enabled": true,
    "publicClient": false,
    "clientAuthenticatorType": "client-secret",
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "frontchannelLogout": false,
    "fullScopeAllowed": true,
    "attributes": {
      "pkce.code.challenge.method": "S256",
      "backchannel.logout.session.required": "true",
      "backchannel.logout.revoke.offline.tokens": "true",
      "use.refresh.tokens": "true"
    },
    "defaultClientScopes": [
      "web-origins",
      "acr",
      "profile",
      "roles",
      "email",
      "basic",
      "organization"
    ],
    "optionalClientScopes": [
      "offline_access"
    ]
  },
  "service": [
    {
      "clientId": "civicos-registry-sync",
      "name": "CivicOS registry sync",
      "description": "Service account used by the council registry to keep Keycloak organisations in step.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "serviceAccountRealmRoles": [],
      "serviceAccountClientRoles": {
        "realm-management": [
          "manage-realm",
          "view-realm",
          "manage-users",
          "view-users",
          "query-users",
          "manage-identity-providers",
          "view-identity-providers"
        ]
      }
    },
    {
      "clientId": "civicos-directory",
      "name": "CivicOS directory",
      "description": "The council directory and registry. No sign-in of its own: it is told about account erasures (civicos.erasure.url) and erases the person's individual record, email and memberships.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "civicos.erasure.url": "{{directoryBackchannelUrl}}/api/auth/civicos/erase",
        "backchannel.logout.url": ""
      }
    },
    {
      "clientId": "civicos-realm-admin",
      "name": "CivicOS realm admin",
      "description": "Service account for scripts/realm/apply.mjs and drift.mjs (KC_ADMIN_CLIENT_ID / KC_ADMIN_CLIENT_SECRET), so neither needs the master admin password or a password grant.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "serviceAccountRealmRoles": [],
      "serviceAccountClientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      }
    }
  ],
  "builtIn": [
    {
      "$comment": "Keycloak's own admin-cli in realm ocn: no password grants (admin scripts use the master realm or a service account).",
      "clientId": "admin-cli",
      "directAccessGrantsEnabled": false
    }
  ]
}
