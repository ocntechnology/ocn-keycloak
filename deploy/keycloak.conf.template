# Keycloak Configuration
# Generated automatically during deployment

# Hostname: fixed to auth.ocn.technology (release step F1). Every issuer, link and redirect is
# built from it, whatever host a request arrived on; hostname-strict is on (the default).
# idp.opencouncil.network is redirected to it by the load balancer (URL map cr-url-map-keycloak).
# During the move both hosts were served with no fixed hostname (docs/cut-over-runbook.md).
hostname=https://auth.ocn.technology

# HTTP Configuration (behind load balancer)
http-enabled=true
http-port=8080
proxy-headers=xforwarded

# Admin credentials
admin={{ KEYCLOAK_ADMIN }}
admin-password={{ KEYCLOAK_ADMIN_PASSWORD }}

# Database Configuration (Cloud SQL)
db=postgres
db-username={{ KEYCLOAK_DB_USER }}
db-password={{ KEYCLOAK_DB_PASSWORD }}
db-url={{ DB_URL }}

# Health and Metrics
health-enabled=true
metrics-enabled=true

