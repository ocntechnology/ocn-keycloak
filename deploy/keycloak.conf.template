# Keycloak Configuration
# Generated automatically during deployment

# Hostname: none fixed during the move from idp.opencouncil.network to auth.ocn.technology.
# Keycloak builds the issuer, links and redirects from the host each request arrived on, so both
# hosts work at once (docs/cut-over-runbook.md). This is only safe because the load balancer
# passes nothing but those two hosts to Keycloak (runbook: load balancer host allowlist).
# Step F1 puts a fixed hostname back once every product uses auth.ocn.technology.
hostname-strict=false

# HTTP Configuration (behind load balancer)
http-enabled=true
http-port=8080
proxy-headers=xforwarded

# Admin credentials
admin={{ KEYCLOAK_ADMIN }}
admin-password={{ KEYCLOAK_ADMIN_PASSWORD }}

# Database Configuration (Cloud SQL)
db=postgres
db-username={{ KEYCLOAK_DB_USER }}
db-password={{ KEYCLOAK_DB_PASSWORD }}
db-url={{ DB_URL }}

# Health and Metrics
health-enabled=true
metrics-enabled=true

